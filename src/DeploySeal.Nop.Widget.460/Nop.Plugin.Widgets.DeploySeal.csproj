<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DeploySeal widget for nopCommerce 4.60 (net7.0).

    Mirrors src/Plugins/Nop.Plugin.Widgets.GoogleAnalytics/*.csproj from release-4.60.6: 4.60
    plugins locate Nop.Web and Build/ClearPluginAssemblies.proj RELATIVELY (..\..\Presentation,
    ..\..\Build) and hand ClearPluginAssemblies "PluginPath=$(MSBuildProjectDirectory)\$(OutDir)",
    whereas 4.90 resolves everything through $(SolutionDir). build/build.ps1 still copies this
    folder into <nop checkout>/src/Plugins/Nop.Plugin.Widgets.DeploySeal before building, so the
    relative paths resolve the same way they do for nopCommerce's own plugins.

    The .NET 7 SDK is end of life and is not installed on developer machines; build.ps1 builds
    this project inside mcr.microsoft.com/dotnet/sdk:7.0 (versions.json "sdkImage") when no
    matching SDK is found, with the repository mounted at /work. DeploySeal-owned paths therefore
    use forward slashes, which MSBuild accepts on both Windows and Linux.

    The platform-independent logic lives in src/DeploySeal.Nop.Core and is compiled INTO this
    assembly so the store gets a single DLL; the Razor views and logo are byte-identical across
    nopCommerce versions and are linked in from src/DeploySeal.Nop.Widget.Shared.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <AssemblyName>Nop.Plugin.Widgets.DeploySeal</AssemblyName>
    <RootNamespace>Nop.Plugin.Widgets.DeploySeal</RootNamespace>
    <Version>1.1.0</Version>
    <Company>DeploySeal</Company>
    <Authors>DeploySeal</Authors>
    <Product>DeploySeal widget for nopCommerce</Product>
    <Copyright>Copyright © DeploySeal</Copyright>
    <PackageProjectUrl>https://deployseal.com/docs/widget</PackageProjectUrl>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Widgets.DeploySeal</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <!-- Keep NuGet-cached DLLs out of the plugin folder; nopCommerce already ships them. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- A plugin is loaded by nopCommerce from Nop.Web's own context; it needs no deps.json of its own. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Ship symbols only in Debug builds. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <!-- net7.0 defaults to C# 11, which is what DeploySeal.Nop.Core is pinned to. -->
    <LangVersion>11</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      "annotations", not "enable": nopCommerce 4.60 itself is not nullable-aware, and with the
      nullable context on, MVC treats every non-nullable string model property as [Required] and
      nop's client-side validation blocks Save. Optional model strings are declared string? so
      the same rule cannot bite even in annotations mode.
    -->
    <Nullable>annotations</Nullable>
    <!-- The .NET 7 runtime is EOL; the warning is noise for a plugin that must target it. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Where this repository lives; overridden by build.ps1 because the project is built from a copy. -->
    <DeploySealRepoRoot Condition="'$(DeploySealRepoRoot)' == ''">$(MSBuildProjectDirectory)/../..</DeploySealRepoRoot>
    <DeploySealShared>$(DeploySealRepoRoot)/src/DeploySeal.Nop.Widget.Shared</DeploySealShared>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(DeploySealRepoRoot)/src/DeploySeal.Nop.Core/**/*.cs"
             Exclude="$(DeploySealRepoRoot)/src/DeploySeal.Nop.Core/bin/**;$(DeploySealRepoRoot)/src/DeploySeal.Nop.Core/obj/**"
             Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="plugin.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(DeploySealShared)/logo.png" Link="logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(DeploySealShared)/Views/Configure.cshtml" Link="Views/Configure.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(DeploySealShared)/Views/PublicInfo.cshtml" Link="Views/PublicInfo.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(DeploySealShared)/Views/_ViewImports.cshtml" Link="Views/_ViewImports.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Presentation\Nop.Web\Nop.Web.csproj" />
    <ClearPluginAssemblies Include="$(MSBuildProjectDirectory)\..\..\Build\ClearPluginAssemblies.proj" />
  </ItemGroup>

  <!--
    Runs after Build (nopCommerce's own "NopTarget" plus one step): ClearPluginAssemblies deletes
    every DLL/PDB that Nop.Web already ships, then the deps/runtimeconfig/staticwebassets manifests
    the Nop.Web ProjectReference copies in are deleted too. What is left: the plugin DLL,
    plugin.json, Views, logo.png.
  -->
  <Target Name="NopTarget" AfterTargets="Build">
    <MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(MSBuildProjectDirectory)\$(OutDir)" Targets="NopClear" />
    <ItemGroup>
      <DeploySealStrayFiles Include="$(OutDir)Nop.Web.*;$(OutDir)*.deps.json;$(OutDir)*.staticwebassets.*.json" />
    </ItemGroup>
    <Delete Files="@(DeploySealStrayFiles)" />
  </Target>

</Project>
